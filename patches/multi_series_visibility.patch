+/// Try to demote a frame's mesh from GPU residency.
+///
+/// Attempts MeshCache refcounted demote first, falls back to direct
+/// FrameStore demote.  Returns true if the demote succeeded or was
+/// skipped (another consumer still holds the mesh).
+fn try_demote(
+    idx: usize,
+    frame_store: &mut FrameStore,
+    mesh_cache: &mut MeshCache,
+    meshes: &mut Assets<Mesh>,
+) -> bool {
+    let path = frame_store.frame_paths.get(idx).cloned();
+    if let Some(ref p) = path {
+        if let Some(cache_entry) = mesh_cache.get_mut(p) {
+            let should_demote = cache_entry.remove_gpu_consumer();
